# Copy to .env.local and fill in real values. Restart `npm run dev` after edits.
# See README for setup instructions.

# ---------------------------------------------------------------------------
# Supabase (Phase 1a — auth, profiles, quota; Phase 1b — pgvector retrieval)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>     # server-only, bypasses RLS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Anthropic Claude (Phase 1b — chat + drafting)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-api03-...

# ---------------------------------------------------------------------------
# Voyage AI (Phase 1b — embeddings via voyage-law-2, 1024d)
# ---------------------------------------------------------------------------

VOYAGE_API_KEY=pa-...

# ---------------------------------------------------------------------------
# Google Gemini (Phase 5 — "Explain in Tagalog" button uses Flash)
# Reuse the BetterAskBock LU key.
# ---------------------------------------------------------------------------

GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Resend (Phase 6 — automated invite emails from /admin/seats)
# Same Resend project that powers Supabase Auth SMTP. The app uses the API
# key directly here (separate from the SMTP password Supabase needs).
# RESEND_FROM_ADDRESS must be a verified sender on the same domain.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_ADDRESS=Ponente <hello@ponente.ph>

# ---------------------------------------------------------------------------
# Sentry (Phase 6 — server-side error capture, no-ops if absent)
# Create a project at https://sentry.io → Settings → DSN.
# ---------------------------------------------------------------------------

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
