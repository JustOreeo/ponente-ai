# Copy to .env and fill in real values.

# ---------------------------------------------------------------------------
# Voyage AI — REQUIRED. Embeds chunks via voyage-law-2 (1024d).
# https://dash.voyageai.com → API Keys
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — REQUIRED. Service-role key bypasses RLS for upserts.
# Same Supabase project as the ponente-ai app.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Gemini — REQUIRED for metadata extraction (Flash, cheap).
# Reuse the BetterAskBock LU key.
# ---------------------------------------------------------------------------
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Crawler tuning
# ---------------------------------------------------------------------------
# Min seconds between requests to elibrary.judiciary.gov.ph (be polite).
CRAWLER_RATE_LIMIT_SECONDS=2.0
# User-Agent used in requests. Identify yourself.
CRAWLER_USER_AGENT=Ponente-Ingestion/0.1 (+contact: hello@ponente.ph)
# Where downloaded PDFs and OCR text are cached.
CACHE_DIR=cache
# Where the SQLite state tracker lives.
STATE_DB=state.db

# ---------------------------------------------------------------------------
# Optional: Google Cloud Document AI fallback for OCR (~5% of pre-2010 PDFs).
# Leave blank to skip the fallback (failed docs are logged + skipped).
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_DOCUMENT_AI_LOCATION=us
GCP_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
